        "# 1. Create backend/src/services/blockchain.ts for transaction verification\n",
        "blockchain_service = \"\"\"import { ethers } from 'ethers';\n",
        "import dotenv from 'dotenv';\n",
        "import prisma from './db';\n",
        "\n",
        "dotenv.config();\n",
        "\n",
        "const ETH_RPC_URL = process.env.ETH_RPC_URL || 'https://eth-sepolia.g.alchemy.com/v2/your-api-key';\n",
        "const sUSD_ABI = [\n",
        "  'event Transfer(address indexed from, address indexed to, uint256 value)',\n",
        "  'function decimals() view returns (uint8)'\n",
        "];\n",
        "\n",
        "export async function verifyTransaction(txHash: string, expectedAmount: number, receiverAddress: string): Promise<boolean> {\n",
        "  try {\n",
        "    const provider = new ethers.JsonRpcProvider(ETH_RPC_URL);\n",
        "    const tx = await provider.getTransactionReceipt(txHash);\n",
        "\n",
        "    if (!tx || tx.status !== 1) {\n",
        "      return false;\n",
        "    }\n",
        "\n",
        "    const iface = new ethers.Interface(sUSD_ABI);\n",
        "    let transferAmountValid = false;\n",
        "\n",
        "    for (const log of tx.logs) {\n",
        "      try {\n",
        "        const parsed = iface.parseLog({\n",
        "          topics: log.topics as string[],\n",
        "          data: log.data\n",
        "        });\n",
        "\n",
        "        if (parsed && parsed.name === 'Transfer') {\n",
        "          const toAddress = parsed.args[1].toLowerCase();\n",
        "          const value = parsed.args[2];\n",
        "          // Convert value to standard decimal notation assuming 18 decimals\n",
        "          const formattedValue = parseFloat(ethers.formatUnits(value, 18));\n",
        "\n",
        "          if (toAddress === receiverAddress.toLowerCase() && Math.abs(formattedValue - expectedAmount) < 0.001) {\n",
        "            transferAmountValid = true;\n",
        "            break;\n",
        "          }\n",
        "        }\n",
        "      } catch (err) {\n",
        "        // Skip logs that do not match the expected event structure\n",
        "        continue;\n",
        "      }\n",
        "    }\n",
        "\n",
        "    return transferAmountValid;\n",
        "  } catch (error) {\n",
        "    console.error('[BLOCKCHAIN VERIFICATION ERROR]:', error);\n",
        "    return false;\n",
        "  }\n",
        "}\n",
        "\"\"\"\n",
