        "import os\n",
        "\n",
        "# 1. Create fx.ts service\n",
        "fx_service_code = \"\"\"import prisma from './db';\n",
        "\n",
        "// Currency exchange rates relative to USD (sUSD as baseline = 1.0)\n",
        "export const EXCHANGE_RATES: { [key: string]: number } = {\n",
        "  USD: 1.0,\n",
        "  EUR: 0.92,\n",
        "  GBP: 0.79,\n",
        "  INR: 83.25,\n",
        "  SGD: 1.34,\n",
        "  AED: 3.67,\n",
        "  JPY: 151.40\n",
        "};\n",
        "\n",
        "export interface QuoteRequest {\n",
        "  sourceCurrency: string;\n",
        "  targetCurrency: string;\n",
        "  sourceAmount: number;\n",
        "}\n",
        "\n",
        "export interface QuoteResponse {\n",
        "  sourceCurrency: string;\n",
        "  targetCurrency: string;\n",
        "  sourceAmount: number;\n",
        "  targetAmount: number;\n",
        "  exchangeRate: number;\n",
        "  fee: number;\n",
        "  netAmount: number;\n",
        "}\n",
        "\n",
        "export async function calculateQuote(req: QuoteRequest): Promise<QuoteResponse> {\n",
        "  const { sourceCurrency, targetCurrency, sourceAmount } = req;\n",
        "\n",
        "  const sourceRate = EXCHANGE_RATES[sourceCurrency.toUpperCase()];\n",
        "  const targetRate = EXCHANGE_RATES[targetCurrency.toUpperCase()];\n",
        "\n",
        "  if (!sourceRate || !targetRate) {\n",
        "    throw new Error(`Unsupported currency conversion from ${sourceCurrency} to ${targetCurrency}`);\n",
        "  }\n",
        "\n",
        "  // Convert source amount to USD first, then to target currency\n",
        "  const amountInUSD = sourceAmount / sourceRate;\n",
        "  const rawTargetAmount = amountInUSD * targetRate;\n",
        "\n",
        "  // Define a flat platform fee of 0.5% of the USD amount\n",
        "  const feeInUSD = amountInUSD * 0.005;\n",
        "  const feeInTarget = feeInUSD * targetRate;\n",
        "\n",
        "  const exchangeRate = targetRate / sourceRate;\n",
        "  const netAmount = rawTargetAmount - feeInTarget;\n",
        "\n",
        "  return {\n",
        "    sourceCurrency: sourceCurrency.toUpperCase(),\n",
        "    targetCurrency: targetCurrency.toUpperCase(),\n",
        "    sourceAmount,\n",
        "    targetAmount: parseFloat(rawTargetAmount.toFixed(4)),\n",
        "    exchangeRate: parseFloat(exchangeRate.toFixed(6)),\n",
        "    fee: parseFloat(feeInTarget.toFixed(4)),\n",
        "    netAmount: parseFloat(netAmount.toFixed(4))\n",
        "  };\n",
        "}\n",
        "\"\"\"\n",
        "\n",
        "with open('backend/src/services/fx.ts', 'w') as f:\n",
        "    f.write(fx_service_code.strip())\n",
        "\n",
        "# 2. Create fx.ts router\n",
        "fx_router_code = \"\"\"import { Router } from 'express';\n",
        "import { calculateQuote } from '../services/fx';\n",
        "import prisma from '../services/db';\n",
        "\n",
        "const router = Router();\n",
        "\n",
        "router.post('/calculate', async (req, res) => {\n",
        "  const { sourceCurrency, targetCurrency, sourceAmount } = req.body;\n",
        "\n",
        "  if (!sourceCurrency || !targetCurrency || sourceAmount === undefined) {\n",
        "    return res.status(400).json({ error: 'Missing sourceCurrency, targetCurrency, or sourceAmount' });\n",
        "  }\n",
        "\n",
        "  const parsedAmount = parseFloat(sourceAmount);\n",
        "  if (isNaN(parsedAmount) || parsedAmount <= 0) {\n",
        "    return res.status(400).json({ error: 'Invalid sourceAmount' });\n",
        "  }\n",
        "\n",
        "  try {\n",
        "    const quote = await calculateQuote({\n",
        "      sourceCurrency,\n",
        "      targetCurrency,\n",
        "      sourceAmount: parsedAmount\n",
        "    });\n",
        "\n",
        "    // Log calculation to database AuditLog\n",
        "    await prisma.auditLog.create({\n",
        "      data: {\n",
        "        action: 'FX_CALCULATION',\n",
        "        details: `Calculated quote: ${sourceAmount} ${sourceCurrency} -> ${quote.targetAmount} ${targetCurrency} at rate ${quote.exchangeRate}. Fee: ${quote.fee} ${targetCurrency}`,\n",
        "        severity: 'INFO'\n",
        "      }\n",
        "    });\n",
        "\n",
        "    return res.json(quote);\n",
        "  } catch (error: any) {\n",
        "    console.error('[FX CALCULATION ERROR]:', error);\n",
        "    return res.status(400).json({ error: error.message || 'FX calculation failed' });\n",
        "  }\n",
        "});\n",
        "\n",
        "export default router;\n",
        "\"\"\"\n",
        "\n",
        "with open('backend/src/routes/fx.ts', 'w') as f:\n",
        "    f.write(fx_router_code.strip())\n",
        "\n",
        "# 3. Update backend entry point to register the FX router\n",
        "express_entry_with_fx = \"\"\"import express from 'express';\n",
        "import cors from 'cors';\n",
        "import * as dotenv from 'dotenv';\n",
        "import prisma from './services/db';\n",
        "import paymentRouter from './routes/payment';\n",
        "import fxRouter from './routes/fx';\n",
        "\n",
        "dotenv.config();\n",
        "\n",
        "const app = express();\n",
        "const PORT = process.env.PORT || 5000;\n",
        "\n",
        "app.use(cors());\n",
        "app.use(express.json());\n",
        "\n",
        "// Register routes\n",
        "app.use('/api/payments', paymentRouter);\n",
        "app.use('/api/fx', fxRouter);\n",
        "\n",
