        "import { verifyTransaction } from '../services/blockchain';\n",
        "\n",
        "const router = Router();\n",
        "\n",
        "// POST /verify\n",
        "router.post('/verify', async (req, res) => {\n",
        "  const { paymentId, txHash } = req.body;\n",
        "\n",
        "  if (!paymentId || !txHash) {\n",
        "    return res.status(400).json({ error: 'Missing paymentId or txHash' });\n",
        "  }\n",
        "\n",
        "  try {\n",
        "    const payment = await prisma.payment.findUnique({\n",
        "      where: { id: paymentId }\n",
        "    });\n",
        "\n",
        "    if (!payment) {\n",
        "      return res.status(404).json({ error: 'Payment record not found' });\n",
        "    }\n",
        "\n",
        "    // Verify transaction on blockchain\n",
        "    const isValid = await verifyTransaction(txHash, payment.targetAmount, payment.receiverAddress);\n",
        "\n",
        "    if (isValid) {\n",
        "      await prisma.payment.update({\n",
        "        where: { id: paymentId },\n",
        "        data: { status: 'COMPLETED', blockchainTx: txHash }\n",
        "      });\n",
        "\n",
        "      await prisma.auditLog.create({\n",
        "        data: {\n",
        "          action: 'PAYMENT_VERIFICATION_SUCCESS',\n",
        "          details: `Payment ${paymentId} verified on-chain via tx ${txHash}`,\n",
        "          severity: 'INFO'\n",
        "        }\n",
        "      });\n",
        "\n",
        "      return res.json({ status: 'SUCCESS', message: 'Payment verified and updated successfully' });\n",
        "    } else {\n",
        "      await prisma.payment.update({\n",
        "        where: { id: paymentId },\n",
        "        data: { status: 'FAILED', blockchainTx: txHash }\n",
        "      });\n",
        "\n",
        "      await prisma.auditLog.create({\n",
        "        data: {\n",
        "          action: 'PAYMENT_VERIFICATION_FAILED',\n",
        "          details: `On-chain verification failed for payment ${paymentId} with tx ${txHash}`,\n",
        "          severity: 'ERROR'\n",
        "        }\n",
        "      });\n",
        "\n",
        "      return res.status(400).json({ status: 'FAILED', message: 'On-chain verification failed' });\n",
        "    }\n",
        "  } catch (error) {\n",
        "    console.error(error);\n",
        "    return res.status(500).json({ error: 'Internal server error' });\n",
        "  }\n",
        "});\n",
        "\n",
        "export default router;\n",
        "\"\"\"\n",
