        "import os\n",
        "\n",
        "# 1. Create directory structure for backend\n",
        "os.makedirs('backend/prisma', exist_ok=True)\n",
        "os.makedirs('backend/src/routes', exist_ok=True)\n",
        "os.makedirs('backend/src/controllers', exist_ok=True)\n",
        "os.makedirs('backend/src/services', exist_ok=True)\n",
        "\n",
        "# 2. Write schema.prisma\n",
        "# We will use SQLite as the database provider so it works out-of-the-box locally without needing a live PostgreSQL service, while keeping schema compatible.\n",
        "prisma_schema = \"\"\"datasource db {\n",
        "  provider = \"sqlite\"\n",
        "  url      = \"file:./dev.db\"\n",
        "}\n",
        "\n",
        "generator client {\n",
        "  provider = \"prisma-client-js\"\n",
        "}\n",
        "\n",
        "model Payment {\n",
        "  id              String   @id @default(uuid())\n",
        "  senderName      String\n",
        "  senderAddress   String\n",
        "  receiverName    String\n",
        "  receiverAddress String\n",
        "  sourceCurrency  String\n",
        "  targetCurrency  String\n",
        "  sourceAmount    Float\n",
        "  targetAmount    Float\n",
        "  exchangeRate    Float\n",
        "  fee             Float\n",
        "  status          String   // PENDING, COMPLETED, FAILED\n",
        "  blockchainTx    String?\n",
        "  createdAt       DateTime @default(now())\n",
        "  updatedAt       DateTime @updatedAt\n",
        "}\n",
        "\n",
        "model AuditLog {\n",
        "  id        String   @id @default(uuid())\n",
        "  action    String\n",
        "  details   String\n",
        "  severity  String   // INFO, WARNING, ERROR\n",
        "  timestamp DateTime @default(now())\n",
        "}\n",
        "\n",
        "model SystemConfig {\n",
        "  key       String   @id\n",
        "  value     String\n",
        "  updatedAt DateTime @updatedAt\n",
        "}\n",
        "\"\"\"\n",
        "\n",
        "with open('backend/prisma/schema.prisma', 'w') as f:\n",
        "    f.write(prisma_schema.strip())\n",
        "\n",
        "# 3. Create database client service\n",
        "prisma_service_code = \"\"\"import { PrismaClient } from '@prisma/client';\n",
        "\n",
        "const prisma = new PrismaClient();\n",
        "\n",
        "export default prisma;\n",
        "\"\"\"\n",
        "\n",
        "with open('backend/src/services/db.ts', 'w') as f:\n",
        "    f.write(prisma_service_code.strip())\n",
        "\n",
        "# 4. Create express backend entry point (src/index.ts)\n",
        "express_entry_code = \"\"\"import express from 'express';\n",
        "import cors from 'cors';\n",
        "import * as dotenv from 'dotenv';\n",
        "import prisma from './services/db';\n",
        "\n",
        "dotenv.config();\n",
        "\n",
        "const app = express();\n",
        "const PORT = process.env.PORT || 5000;\n",
        "\n",
        "app.use(cors());\n",
        "app.use(express.json());\n",
        "\n",
        "// Basic health check route\n",
        "app.get('/api/health', async (req, res) => {\n",
        "  try {\n",
        "    // Simple query to verify database connection\n",
        "    await prisma.systemConfig.findMany();\n",
        "    res.json({ status: 'OK', database: 'CONNECTED', timestamp: new Date() });\n",
        "  } catch (error) {\n",
        "    res.status(500).json({ status: 'ERROR', database: 'DISCONNECTED', error: String(error) });\n",
        "  }\n",
        "});\n",
        "\n",
        "app.listen(PORT, () => {\n",
        "  console.log(`[STABLEPAY BACKEND] Server running on port ${PORT}`);\n",
        "});\n",
        "\"\"\"\n",
        "\n",
        "with open('backend/src/index.ts', 'w') as f:\n",
        "    f.write(express_entry_code.strip())\n",
        "\n",
        "# 5. Create tsconfig.json for backend\n",
        "tsconfig_backend = {\n",
        "  \"compilerOptions\": {\n",
        "    \"target\": \"es2020\",\n",
        "    \"module\": \"commonjs\",\n",
        "    \"lib\": [\"es2020\"],\n",
        "    \"strict\": true,\n",
        "    \"esModuleInterop\": true,\n",
        "    \"skipLibCheck\": true,\n",
        "    \"forceConsistentCasingInFileNames\": true,\n",
        "    \"outDir\": \"./dist\",\n",
        "    \"rootDir\": \"./src\"\n",
        "  },\n",
        "  \"include\": [\"src/**/*\"]\n",
        "}\n",
        "\n",
        "with open('backend/tsconfig.json', 'w') as f:\n",
        "    json.dump(tsconfig_backend, f, indent=2)\n",
        "\n",
        "print(\"Prisma Schema, Backend express architecture, Database Client, TSConfig are successfully generated.\")"
      ],
