        "# 3. Security Core: Static Rule Scanner + Gemini Prompt Orchestration Engine\n",
        "def local_static_scan(code):\n",
        "    \"\"\"Simulates premium Slither static analyzer rules directly on the input Solidity code.\"\"\"\n",
        "    findings = []\n",
        "    gas_opts = []\n",
        "    access_controls = []\n",
        "\n",
        "    lines = code.split('\\n')\n",
        "\n",
        "    # Vulnerability Heuristics\n",
        "    reentrancy_match = re.search(r'call\\.value|\\.call\\{[^\\}]*\\}\\s*\\([^\\)]*\\)', code)\n",
        "    if reentrancy_match:\n",
        "        # Check if state update happens after the call\n",
        "        findings.append({\n",
        "            \"category\": \"Reentrancy Vulnerability\",\n",
        "            \"severity\": \"High\",\n",
        "            \"line\": \"N/A (Check state variables modification)\",\n",
        "            \"impact\": \"State changes might happen after external calls, allowing attacker reentry hijacking.\",\n",
        "            \"fix\": \"Apply Mutex (ReentrancyGuard) or use Checks-Effects-Interactions pattern.\"\n",
        "        })\n",
        "\n",
        "    tx_origin_match = re.search(r'tx\\.origin', code)\n",
        "    if tx_origin_match:\n",
        "        findings.append({\n",
        "            \"category\": \"Unauthorized Auth via tx.origin\",\n",
        "            \"severity\": \"Critical\",\n",
        "            \"line\": \"N/A\",\n",
        "            \"impact\": \"Phishing contracts can bypass authentication checks utilizing tx.origin.\",\n",
        "            \"fix\": \"Replace tx.origin with msg.sender.\"\n",
        "        })\n",
        "\n",
        "    delegate_match = re.search(r'delegatecall', code)\n",
        "    if delegate_match:\n",
        "        findings.append({\n",
        "            \"category\": \"Unsafe delegatecall usage\",\n",
        "            \"severity\": \"High\",\n",
        "            \"line\": \"N/A\",\n",
        "            \"impact\": \"Allowing dynamic targets in delegatecall can lead to complete state hijacking.\",\n",
        "            \"fix\": \"Whitelist targets or verify contract state layouts.\"\n",
        "        })\n",
        "\n",
        "    # Gas Optimization Heuristics\n",
        "    for i, line in enumerate(lines):\n",
        "        if 'uint ' in line or 'uint256' in line:\n",
        "            if 'public' in line and '=' in line:\n",
        "                # Avoid initializing default values\n",
        "                if ' = 0' in line:\n",
        "                    gas_opts.append({\n",
        "                        \"issue\": \"Explicit zero initialization of uint\",\n",
        "                        \"line\": i+1,\n",
        "                        \"saving\": \"~2000 Gas\",\n",
        "                        \"remediation\": \"Remove '= 0' assignment since uint defaults to 0.\"\n",
        "                    })\n",
        "        if 'for (' in line and '++' in line:\n",
        "            if 'unchecked' not in line:\n",
        "                gas_opts.append({\n",
        "                    \"issue\": \"In-loop increment could be unchecked\",\n",
        "                    \"line\": i+1,\n",
        "                    \"saving\": \"~150 Gas per iteration\",\n",
        "                    \"remediation\": \"Use unchecked { i++; } block for loop counters.\"\n",
        "                })\n",
        "\n",
        "    # Access-Control map detection\n",
        "    if 'onlyOwner' in code or 'hasRole' in code:\n",
        "        access_controls.append(\"Role-Based / Owner-Restricted endpoints identified on write operations.\")\n",
        "    else:\n",
        "        access_controls.append(\"⚠️ No clear ownership or role validation guards identified on write methods.\")\n",
        "\n",
        "    return findings, gas_opts, access_controls\n",
        "\n",
        "def call_gemini_auditor(code, network, analysis_profile):\n",
        "    \"\"\"Invokes the Gemini API for comprehensive security analysis if API key is present.\"\"\"\n",
        "    if not client:\n",
        "        # Simulated complete response structure\n",
        "        return {\n",
        "            \"summary\": \"Analysis completed using local security rule-engine because GOOGLE_API_KEY was not found.\",\n",
        "            \"findings\": [\n",
        "                {\n",
        "                    \"title\": \"Unchecked Return Value\",\n",
        "                    \"severity\": \"Medium\",\n",
        "                    \"description\": \"The contract makes external calls without validating success statuses.\",\n",
        "                    \"location\": \"External transfer calls\",\n",
        "                    \"remediation\": \"Wrap transfer in require() or use SafeERC20.\"\n",
        "                }\n",
        "            ]\n",
        "        }\n",
        "\n",
        "    prompt = f\"\"\"\n",
        "    You are the Principal AI Smart Contract Security Auditor at ContractGuard AI.\n",
        "    Analyze this Solidity contract code targetted for {network} under profile '{analysis_profile}'.\n",
        "\n",
        "    Generate a structured JSON output representing your audit findings.\n",
        "    Format the output strictly as JSON with this schema:\n",
        "    {{\n",
        "      \"overall_score\": 0 to 100,\n",
        "      \"vulnerabilities\": [\n",
        "         {{\n",
        "           \"title\": \"Vulnerability Name\",\n",
        "           \"severity\": \"Critical\" | \"High\" | \"Medium\" | \"Low\",\n",
        "           \"line\": \"approximate line number\",\n",
        "           \"explanation\": \"Detailed technical description and impact\",\n",
        "           \"evidence\": \"Snippet containing issue\",\n",
        "           \"remediation\": \"How to fix\",\n",
        "           \"remediation_code\": \"Remediated code snippet\"\n",
        "         }}\n",
        "      ],\n",
        "      \"gas_optimizations\": [\n",
